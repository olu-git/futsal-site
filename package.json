{
  "name": "futsal-league",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/preview-static.mjs",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "season:import:validate": "tsx scripts/generate-current-season-import.ts --validate-only",
