# Supabase public client configuration. Add real values to .env.local only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional per-form Web3Forms keys; leave unset to use the shared public fallback.
# NEXT_PUBLIC_WEB3FORMS_TEAM_KEY=your-public-access-key
# NEXT_PUBLIC_WEB3FORMS_PLAYER_KEY=your-public-access-key
# NEXT_PUBLIC_WEB3FORMS_FUTURE_KEY=your-public-access-key
# NEXT_PUBLIC_WEB3FORMS_CONTACT_KEY=your-public-access-key
